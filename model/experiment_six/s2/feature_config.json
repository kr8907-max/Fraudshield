{
  "representation": "S1 scheme-blind field-separated TF-IDF + keyword counts, with a www-normalised hostname",
  "change_vs_s1": "host block input only",
  "normalization": {
    "function": "host.strip().lower(); if startswith('www.') and len>4: host[4:]",
    "removes": "exactly one leading literal 'www.'",
    "does_not_remove": [
      "www2.",
      "ww2.",
      "m.",
      "wap.",
      "any non-leading label"
    ],
    "applies_to": [
      "HOST feature block"
    ],
    "does_not_apply_to": [
      "path block",
      "query block",
      "keyword-count block"
    ],
    "original_url_untouched": true
  },
  "scheme_handling": {
    "scheme_is_a_feature": false,
    "preprocessing": "http(s):// prefix stripped before any feature"
  },
  "blocks": {
    "host": {
      "field": "normalized hostname",
      "config": {
        "analyzer": "char_wb",
        "ngram_range": [
          3,
          5
        ],
        "max_features": 30000,
        "min_df": 3,
        "sublinear_tf": true,
        "dtype": "float32",
        "lowercase": true
      },
      "vocab_size": 30000,
      "offset": 0
    },
    "path": {
      "field": "path",
      "config": {
        "analyzer": "word",
        "ngram_range": [
          1,
          2
        ],
        "max_features": 50000,
        "min_df": 5,
        "sublinear_tf": true,
        "dtype": "float32",
        "lowercase": false,
        "token_pattern": "(?u)\\b\\w+\\b"
      },
      "vocab_size": 50000,
      "offset": 30000
    },
    "query": {
      "field": "query",
      "config": {
        "analyzer": "word",
        "ngram_range": [
          1,
          1
        ],
        "max_features": 20000,
        "min_df": 5,
        "sublinear_tf": true,
        "dtype": "float32",
        "lowercase": false,
        "token_pattern": "(?u)\\b\\w+\\b"
      },
      "vocab_size": 7500,
      "offset": 80000
    },
    "suspicious_vocab": {
      "fields": [
        "host",
        "path",
        "query"
      ],
      "keywords": [
        "login",
        "signin",
        "verify",
        "account",
        "update",
        "secure",
        "password",
        "bank",
        "confirm",
        "payment",
        "security",
        "wallet",
        "authentication",
        "bonus",
        "prize"
      ],
      "count": 45,
      "offset": 87500
    }
  },
  "total_features": 87545,
  "model_config": {
    "class_weight": "balanced",
    "C": 1.0,
    "solver": "lbfgs",
    "max_iter": 400,
    "random_state": 42
  }
}
